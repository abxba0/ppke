# PPKE Environment Configuration
# Copy this to .env and fill in your values

# ── LLM API Keys (at least one required) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ── Database ──
# Uncomment for PostgreSQL (Docker Compose 'full' profile):
# DATABASE_URL=postgresql://ppke:ppke_secret@postgres:5432/ppke

# ── Redis ──
# Uncomment for Redis caching + Celery task queue:
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/0

# ── Monitoring ──
PPKE_ENVIRONMENT=production
PPKE_LOG_FORMAT=json
PPKE_LOG_LEVEL=INFO
PPKE_METRICS_ENABLED=true
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Object Storage ──
PPKE_STORAGE_BACKEND=local
# For S3:
# PPKE_STORAGE_BACKEND=s3
# AWS_S3_BUCKET=my-ppke-bucket
# AWS_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Auth ──
# PPKE_JWT_SECRET=  # Auto-generated if not set
# GOOGLE_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ── Docker Compose ports ──
PPKE_PORT=8000
REDIS_PORT=6379
POSTGRES_PORT=5432
CHROMA_PORT=8001
POSTGRES_DB=ppke
POSTGRES_USER=ppke
POSTGRES_PASSWORD=ppke_secret
